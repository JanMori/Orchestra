# ==============================================================================
# 数据查询执行接口技能配置 (data-query-execution-skill)
# 复制本文件为 .env 并填写配置，scripts/*.py 将自动向上加载本目录的 .env
# ==============================================================================

# 接口地址 (例如: http://<DATA_QUERY_HOST>:<PORT>/data-development/task/execute-sql)
EXTERNAL_DATA_QUERY_API_URL=http://<DATA_QUERY_HOST>:<PORT>/data-development/task/execute-sql

# 用户登录后的 Access Token (也可以设置系统环境变量 DATA_QUERY_TOKEN 或 AUTH_TOKEN)
DATA_QUERY_TOKEN=

# 目标数据源 ID (用于查询 JDBC 连接信息，缺省为 20)
DATA_QUERY_DATABASE_ID=20

# 任务 ID (后端用于记录执行历史和任务关联，缺省为 69)
DATA_QUERY_TASK_ID=69

# 数据库类型 (1=普通数据库, 2=中台库)
DATA_QUERY_SQL_DB_TYPE=1

# SQL 方言 (1=普通 SQL/MySQL/Oracle, 非 Flink)
DATA_QUERY_DIALECT=1

# 最大返回行数 (默认 1000)
DATA_QUERY_MAX_ROW_NUM=1000

# 设为 false 启用真实 HTTP API 接口调用
DATA_QUERY_MOCK_MODE=false
